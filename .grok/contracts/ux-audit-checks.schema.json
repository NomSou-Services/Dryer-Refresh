{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UX Audit Checks Contract",
  "type": "object",
  "required": [
    "version",
    "severityModel",
    "checks"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "severityModel": {
      "type": "object",
      "required": [
        "critical",
        "high",
        "medium",
        "low",
        "info"
      ],
      "properties": {
        "critical": {
          "type": "string"
        },
        "high": {
          "type": "string"
        },
        "medium": {
          "type": "string"
        },
        "low": {
          "type": "string"
        },
        "info": {
          "type": "string"
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "area",
          "questions"
        ],
        "properties": {
          "area": {
            "type": "string"
          },
          "questions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 2
          }
        }
      }
    }
  }
}
