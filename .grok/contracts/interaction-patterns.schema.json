{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Interaction Patterns Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "patterns",
    "rules"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "patterns": {
      "type": "object",
      "required": [
        "navigation",
        "buttons",
        "dialogs",
        "feedback"
      ],
      "properties": {
        "navigation": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 3
        },
        "buttons": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 3
        },
        "dialogs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 3
        },
        "feedback": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 3
        }
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 5
    }
  }
}
