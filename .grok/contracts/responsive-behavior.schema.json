{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Responsive Behavior Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "principles",
    "checks"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "principles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 5
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 6
    }
  }
}
